#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import os
import pathlib
import plistlib
import re
import subprocess
import sys
import urllib.parse

HOME = pathlib.Path(os.environ.get("AGENT_ASSETS_USER_HOME", str(pathlib.Path.home()))).expanduser()
CONFIG_HOME = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", str(HOME / ".config"))).expanduser()
ASSETS_HOME = pathlib.Path(os.environ.get("AGENT_ASSETS_HOME", str(CONFIG_HOME / "agent-assets"))).expanduser()
REGISTRY = pathlib.Path(os.environ.get("AGENT_ASSETS_REGISTRY", str(ASSETS_HOME / "registry.json"))).expanduser()
OUT = pathlib.Path(
    os.environ.get(
        "AGENT_ASSETS_MACOS_SIGNALS",
        os.environ.get("AGENT_ASSETS_MACOS_SIGNALS_INDEX", str(ASSETS_HOME / "macos-signals.json")),
    )
).expanduser()

USER_LAUNCH_AGENTS = HOME / "Library/LaunchAgents"
LAUNCH_ROOTS = [
    (USER_LAUNCH_AGENTS, "user-agent", "gui"),
    (pathlib.Path("/Library/LaunchAgents"), "global-agent", "gui"),
    (pathlib.Path("/Library/LaunchDaemons"), "system-daemon", "system"),
]
PRIVILEGED_HELPERS = pathlib.Path("/Library/PrivilegedHelperTools")

REMOTE_PATTERNS = re.compile(r"todesk|awesun|oray|sunlogin|向日葵|remote|screenconnect|anydesk", re.I)
PROXY_PATTERNS = re.compile(r"clash|mihomo|proxy|vortex|vpn|tailscale|wireguard", re.I)
AGENT_PATTERNS = re.compile(r"gbrain|mcp|agent-assets|openclaw|hermes|cc-connect|new-api|newapi|edict|ai-writing|codex|claude", re.I)
UPDATER_PATTERNS = re.compile(r"updater|keystone|shipit|update", re.I)
INPUT_METHOD_PATTERNS = re.compile(r"sogou|input method|输入法", re.I)
GENERIC_PROCESS_NAMES = {
    "python",
    "python3",
    "python3.9",
    "python3.10",
    "python3.11",
    "python3.12",
    "python3.13",
    "python3.14",
    "node",
    "bun",
    "bash",
    "zsh",
    "sh",
    "ruby",
    "perl",
    "java",
}


def now_iso():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def run_command(command, timeout=10):
    try:
        proc = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return "", f"{command[0]} not found", 127
    except Exception as exc:
        return "", str(exc), 1
    return proc.stdout or "", proc.stderr or "", proc.returncode


def load_json(path):
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def write_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


def listify(value):
    if not value:
        return []
    if isinstance(value, list):
        return [str(v) for v in value if v is not None]
    return [str(value)]


def safe_resolve(path):
    try:
        return pathlib.Path(path).expanduser().resolve(strict=False)
    except Exception:
        return pathlib.Path(path).expanduser().absolute()


def is_under(path, parent):
    try:
        safe_resolve(path).relative_to(safe_resolve(parent))
        return True
    except ValueError:
        return False


def url_to_path(value):
    if not value or not str(value).startswith("file://"):
        return ""
    parsed = urllib.parse.urlsplit(str(value))
    return urllib.parse.unquote(parsed.path)


def normalize_identifier(value):
    value = str(value or "").strip()
    value = re.sub(r"^\d+\.", "", value)
    return value


def item_key(*values):
    for value in values:
        value = normalize_identifier(value)
        if value and value not in {"(null)", "Unknown Developer"}:
            return value
    return "unknown"


def append_unique(target, key, values):
    bucket = target.setdefault(key, [])
    for value in values:
        if value and value not in bucket:
            bucket.append(value)


def parse_btm():
    stdout, stderr, code = run_command(["sfltool", "dumpbtm"], timeout=45)
    records = []
    current = None
    in_embedded = False
    for line in stdout.splitlines():
        if re.match(r"^ #\d+:\s*$", line):
            if current:
                records.append(current)
            current = {"embedded_item_identifiers": []}
            in_embedded = False
            continue
        if current is None:
            continue
        if line.strip() == "Embedded Item Identifiers:":
            in_embedded = True
            continue
        if in_embedded:
            embedded = re.match(r"\s+#\d+:\s*(.+)$", line)
            if embedded:
                current["embedded_item_identifiers"].append(embedded.group(1).strip())
                continue
            if line.strip():
                in_embedded = False
        match = re.match(r"\s*([^:]+):\s*(.*)$", line)
        if match:
            current[match.group(1).strip()] = match.group(2).strip()
    if current:
        records.append(current)
    return {
        "records": records,
        "raw_error": stderr.strip(),
        "returncode": code,
    }


def parse_plist(path):
    try:
        with path.open("rb") as f:
            data = plistlib.load(f)
    except Exception as exc:
        return {"_error": str(exc)}
    return data


def parse_launch_plists():
    rows = []
    for root, role, domain in LAUNCH_ROOTS:
        if not root.exists():
            continue
        for path in sorted(root.glob("*.plist")):
            data = parse_plist(path)
            args = listify(data.get("ProgramArguments"))
            program = str(data.get("Program") or (args[0] if args else ""))
            label = str(data.get("Label") or path.stem)
            rows.append({
                "label": label,
                "plist": str(path),
                "role": role,
                "domain": domain,
                "program": program,
                "arguments": args[:12],
                "run_at_load": data.get("RunAtLoad"),
                "keep_alive": data.get("KeepAlive"),
                "mach_services": sorted(list((data.get("MachServices") or {}).keys())),
                "error": data.get("_error", ""),
            })
    return rows


def parse_launchctl(label, domain):
    if not label:
        return {}
    target = f"system/{label}" if domain == "system" else f"gui/{os.getuid()}/{label}"
    stdout, stderr, code = run_command(["launchctl", "print", target], timeout=4)
    if code != 0:
        return {
            "target": target,
            "available": False,
            "error": (stderr or stdout).strip(),
        }
    state = ""
    pid = ""
    last_exit_code = ""
    program = ""
    for line in stdout.splitlines():
        text = line.strip()
        if not state and text.startswith("state = "):
            state = text.split("=", 1)[1].strip()
        elif not pid and text.startswith("pid = "):
            pid = text.split("=", 1)[1].strip()
        elif not last_exit_code and text.startswith("last exit code = "):
            last_exit_code = text.split("=", 1)[1].strip()
        elif not program and text.startswith("program = "):
            program = text.split("=", 1)[1].strip()
    return {
        "target": target,
        "available": True,
        "state": state,
        "pid": pid,
        "last_exit_code": last_exit_code,
        "program": program,
    }


def parse_processes():
    stdout, _stderr, _code = run_command(["ps", "ax", "-o", "pid=,ppid=,stat=,args="], timeout=10)
    rows = []
    own_pid = os.getpid()
    for line in stdout.splitlines():
        match = re.match(r"\s*(\d+)\s+(\d+)\s+(\S+)\s+(.*)$", line)
        if not match:
            continue
        pid = int(match.group(1))
        if pid == own_pid:
            continue
        args = match.group(4)
        if "agent-assets-macos-signals" in args:
            continue
        rows.append({
            "pid": pid,
            "ppid": int(match.group(2)),
            "stat": match.group(3),
            "args": args,
        })
    return rows


def parse_listeners():
    stdout, _stderr, _code = run_command(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"], timeout=12)
    listeners = []
    for index, line in enumerate(stdout.splitlines()):
        if index == 0 and line.startswith("COMMAND"):
            continue
        parts = line.split(None, 8)
        if len(parts) < 9:
            continue
        name = parts[8]
        port = ""
        port_match = re.search(r":(\d+)(?:\s|\(|$)", name)
        if port_match:
            port = port_match.group(1)
        listeners.append({
            "command": parts[0],
            "pid": int(parts[1]) if parts[1].isdigit() else None,
            "user": parts[2],
            "name": name,
            "port": port,
        })
    return listeners


def parse_privileged_helpers():
    helpers = []
    if not PRIVILEGED_HELPERS.exists():
        return helpers
    for path in sorted(PRIVILEGED_HELPERS.iterdir(), key=lambda p: p.name.lower()):
        helpers.append({
            "name": path.name,
            "path": str(path),
            "is_dir": path.is_dir(),
            "exists": path.exists(),
        })
    return helpers


def parse_system_extensions():
    stdout, stderr, code = run_command(["systemextensionsctl", "list"], timeout=10)
    extensions = []
    for line in stdout.splitlines():
        text = line.strip()
        if not text or text.startswith("0 extension") or text.startswith("*"):
            continue
        extensions.append(text)
    return {
        "extensions": extensions,
        "raw_error": stderr.strip(),
        "returncode": code,
    }


def parse_login_items():
    script = 'tell application "System Events" to get the name of every login item'
    stdout, _stderr, code = run_command(["osascript", "-e", script], timeout=8)
    items = [item.strip() for item in stdout.strip().split(",") if item.strip()] if code == 0 else []
    return items


def registry_refs():
    registry = load_json(REGISTRY)
    refs = []
    for asset_id, asset in registry.get("assets", {}).items():
        for key in ("stable_entrypoints", "source_paths", "project_paths", "config_paths", "host_configs"):
            for value in listify(asset.get(key)):
                if str(value).startswith("/"):
                    refs.append((asset_id, key, value))
    return refs


def linked_assets(paths, text, refs):
    linked = []
    text_l = (text or "").lower()
    resolved_paths = [safe_resolve(path) for path in paths if path and str(path).startswith("/")]
    for asset_id, key, value in refs:
        value_s = str(value)
        matched = False
        if value_s.startswith("/"):
            ref = safe_resolve(value_s)
            matched = any(path == ref or is_under(path, ref) or is_under(ref, path) for path in resolved_paths)
        if matched:
            item = f"{asset_id}:{key}"
            if item not in linked:
                linked.append(item)
    return linked


def match_processes(item, processes):
    patterns = []
    for value in (item.get("label"), item.get("name"), item.get("identifier")):
        value = normalize_identifier(value)
        if value and len(value) >= 4:
            patterns.append(value.lower())
    for path in item.get("paths", []):
        if path:
            patterns.append(path.lower())
            basename = pathlib.Path(path).name.lower()
            if len(basename) >= 4 and basename not in GENERIC_PROCESS_NAMES and not basename.endswith(".plist"):
                patterns.append(basename)
    patterns = sorted(set(patterns), key=len, reverse=True)
    matches = []
    for proc in processes:
        args_l = proc["args"].lower()
        if any(pattern and pattern in args_l for pattern in patterns):
            matches.append(proc)
    return matches[:8]


def infer_tags(item):
    text = " ".join([
        item.get("label", ""),
        item.get("name", ""),
        item.get("identifier", ""),
        item.get("developer", ""),
        " ".join(item.get("paths", [])),
    ])
    tags = set()
    if item.get("btm_enabled"):
        tags.add("enabled")
    if item.get("btm_disabled"):
        tags.add("disabled")
    if item.get("running"):
        tags.add("running")
    else:
        tags.add("not-running")
    if item.get("listeners"):
        tags.add("listening")
    if item.get("launch_role") == "system-daemon" or any("/Library/PrivilegedHelperTools" in p for p in item.get("paths", [])):
        tags.add("privileged")
    if item.get("launch_role") in {"user-agent", "global-agent"}:
        tags.add("launch-agent")
    if item.get("launch_role") == "system-daemon":
        tags.add("launch-daemon")
    if item.get("launch_last_exit_code") and item.get("launch_last_exit_code") not in {"(never exited)", "0"}:
        tags.add("error")
    if item.get("launch_state") in {"spawn scheduled", "crashed", "exited"}:
        tags.add("attention")
    if REMOTE_PATTERNS.search(text):
        tags.add("remote-control")
    if PROXY_PATTERNS.search(text):
        tags.add("network-proxy")
    if AGENT_PATTERNS.search(text):
        tags.add("agent-service")
    if UPDATER_PATTERNS.search(text):
        tags.add("updater")
    if INPUT_METHOD_PATTERNS.search(text):
        tags.add("input-method")
    if tags & {"privileged", "remote-control", "network-proxy", "listening", "error"}:
        tags.add("attention")
    if (item.get("btm_enabled") or item.get("launch_plist")) and not item.get("running"):
        tags.add("residual-candidate")
    if item.get("linked_assets"):
        tags.add("linked")
    return sorted(tags)


def action_hint(item):
    tags = set(item.get("tags", []))
    if "running" in tags and "listening" in tags:
        return "Active local service: verify owner, port, and whether it belongs in the asset registry."
    if "running" in tags and "privileged" in tags:
        return "Privileged helper is running: verify the parent app and keep/remove decision."
    if "error" in tags:
        return "Launch item has a non-zero exit or scheduled spawn: inspect logs before deciding."
    if "residual-candidate" in tags and "privileged" in tags:
        return "Privileged helper remains but is not running: likely cleanup/review candidate."
    if "residual-candidate" in tags:
        return "Launch/login trace remains but no running process was matched."
    if "linked" not in tags and ("agent-service" in tags or "listening" in tags):
        return "Looks agent-facing but is not linked to an asset yet."
    return "Record and review only; do not remove without confirming the parent app."


def upsert(items, key, **values):
    item = items.setdefault(key, {
        "id": key,
        "label": key,
        "name": "",
        "identifier": "",
        "developer": "",
        "team_identifier": "",
        "paths": [],
        "sources": [],
    })
    for scalar in ("label", "name", "identifier", "developer", "team_identifier", "launch_role", "launch_state", "launch_pid", "launch_last_exit_code", "launch_plist"):
        value = values.get(scalar)
        if value and not item.get(scalar):
            item[scalar] = value
    append_unique(item, "paths", values.get("paths", []))
    append_unique(item, "sources", values.get("sources", []))
    if "btm_enabled" in values:
        item["btm_enabled"] = item.get("btm_enabled", False) or bool(values["btm_enabled"])
    if "btm_disabled" in values:
        item["btm_disabled"] = item.get("btm_disabled", False) or bool(values["btm_disabled"])
    if "launch_run_at_load" in values:
        item["launch_run_at_load"] = values.get("launch_run_at_load")
    if "launch_keep_alive" in values:
        item["launch_keep_alive"] = values.get("launch_keep_alive")
    return item


def build_items(raw):
    refs = registry_refs()
    items = {}
    for record in raw["btm"]["records"]:
        identifier = normalize_identifier(record.get("Identifier"))
        name = record.get("Name") if record.get("Name") != "(null)" else ""
        executable = record.get("Executable Path") or url_to_path(record.get("URL")) or ""
        key = item_key(identifier, name, pathlib.Path(executable).name if executable else "")
        disposition = record.get("Disposition", "")
        upsert(
            items,
            key,
            label=key,
            name=name,
            identifier=identifier,
            developer=record.get("Developer Name") if record.get("Developer Name") != "(null)" else "",
            team_identifier=record.get("Team Identifier", ""),
            paths=[executable] if executable else [],
            sources=["btm"],
            btm_enabled="enabled" in disposition,
            btm_disabled="disabled" in disposition,
        )
    for row in raw["launch_plists"]:
        label = row["label"]
        key = item_key(label, row.get("program"), pathlib.Path(row["plist"]).stem)
        paths = [row["plist"]]
        if row.get("program"):
            paths.append(row["program"])
        launch = parse_launchctl(label, row["domain"])
        upsert(
            items,
            key,
            label=label,
            identifier=label,
            paths=paths,
            sources=["launch-plist"],
            launch_role=row["role"],
            launch_state=launch.get("state", ""),
            launch_pid=launch.get("pid", ""),
            launch_last_exit_code=launch.get("last_exit_code", ""),
            launch_plist=row["plist"],
            launch_run_at_load=row.get("run_at_load"),
            launch_keep_alive=row.get("keep_alive"),
        )
    helper_names = {pathlib.Path(path).name.lower() for item in items.values() for path in item.get("paths", [])}
    for helper in raw["privileged_helpers"]:
        if helper["name"].lower() in helper_names:
            continue
        key = item_key(helper["name"])
        upsert(items, key, label=helper["name"], identifier=helper["name"], paths=[helper["path"]], sources=["privileged-helper"])

    processes = raw["processes"]
    listeners_by_pid = {}
    for listener in raw["listeners"]:
        if listener.get("pid"):
            listeners_by_pid.setdefault(listener["pid"], []).append(listener)
    for item in items.values():
        launch_pid = str(item.get("launch_pid") or "")
        matched = [proc for proc in processes if str(proc["pid"]) == launch_pid] if launch_pid.isdigit() else []
        if not matched:
            matched = match_processes(item, processes)
        item["processes"] = matched
        item["running"] = bool(matched) or item.get("launch_state") == "running" or bool(item.get("launch_pid"))
        listeners = []
        for proc in matched:
            listeners.extend(listeners_by_pid.get(proc["pid"], []))
        item["listeners"] = listeners
        linked = linked_assets(item.get("paths", []), json.dumps(item, ensure_ascii=False), refs)
        item["linked_assets"] = linked
        item["tags"] = infer_tags(item)
        item["action_hint"] = action_hint(item)

    rows = sorted(items.values(), key=lambda item: (
        0 if "attention" in item.get("tags", []) else 1,
        0 if item.get("running") else 1,
        item.get("label", "").lower(),
    ))
    return rows


def summarize(items, raw):
    summary = {
        "total": len(items),
        "btm_records": len(raw["btm"]["records"]),
        "launch_plists": len(raw["launch_plists"]),
        "running": 0,
        "listening": 0,
        "privileged": 0,
        "attention": 0,
        "residual_candidates": 0,
        "linked": 0,
        "system_extensions": len(raw["system_extensions"]["extensions"]),
        "login_items": len(raw["login_items"]),
    }
    for item in items:
        tags = set(item.get("tags", []))
        if item.get("running"):
            summary["running"] += 1
        if "listening" in tags:
            summary["listening"] += 1
        if "privileged" in tags:
            summary["privileged"] += 1
        if "attention" in tags:
            summary["attention"] += 1
        if "residual-candidate" in tags:
            summary["residual_candidates"] += 1
        if item.get("linked_assets"):
            summary["linked"] += 1
    return summary


def scan():
    raw = {
        "btm": parse_btm(),
        "launch_plists": parse_launch_plists(),
        "privileged_helpers": parse_privileged_helpers(),
        "system_extensions": parse_system_extensions(),
        "login_items": parse_login_items(),
        "processes": parse_processes(),
        "listeners": parse_listeners(),
    }
    items = build_items(raw)
    return {
        "updated_at": now_iso(),
        "source": "agent-assets-macos-signals",
        "policy": {
            "read_only": True,
            "does_not_unload_launchd": True,
            "does_not_delete_files": True,
            "does_not_disable_login_items": True,
        },
        "items": items,
        "summary": summarize(items, raw),
        "raw": {
            "btm_returncode": raw["btm"]["returncode"],
            "btm_error": raw["btm"]["raw_error"],
            "system_extensions": raw["system_extensions"],
            "login_items": raw["login_items"],
        },
    }


def main():
    parser = argparse.ArgumentParser(description="Index macOS login/background/launchd/service traces without changing them.")
    parser.add_argument("--json", action="store_true", help="Print the full JSON payload.")
    parser.add_argument("--no-write", action="store_true", help="Do not write macos-signals.json.")
    args = parser.parse_args()

    payload = scan()
    if not args.no_write:
        write_json(OUT, payload)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        summary = payload["summary"]
        destination = "not written" if args.no_write else str(OUT)
        print(
            "macOS signals indexed: "
            f"{summary['total']} items, "
            f"{summary['running']} running, "
            f"{summary['listening']} listening, "
            f"{summary['privileged']} privileged, "
            f"{summary['attention']} attention, "
            f"{summary['residual_candidates']} residual candidates. "
            f"output: {destination}"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
