    .scan-action[hidden] {{ display: none; }}
    .primary-action, .secondary-action {{
      border: 1px solid #1d4ed8;
      border-radius: 8px;
      min-height: 40px;
      padding: 0 14px;
      font: inherit;
      font-weight: 650;
      cursor: pointer;
