  <script>
    const buttons = Array.from(document.querySelectorAll("[data-tab]"));
    const sections = Array.from(document.querySelectorAll(".section"));
    const search = document.getElementById("search");
    const pageTitle = document.getElementById("pageTitle");
    const pageSubtitle = document.getElementById("pageSubtitle");
    const scanAction = document.getElementById("scanAction");
    const scanButtons = Array.from(document.querySelectorAll(".scan-button"));
    const scanStatus = document.getElementById("scanStatus");
    const filterButtons = Array.from(document.querySelectorAll(".filter-chip"));
    const tabCopy = {{
      overview: {{
        title: "总览",
        subtitle: "先看问题和下一步动作，不在总览里堆列表。"
      }},
      assets: {{
        title: "资产",
        subtitle: "正式登记过的本机 Agent 资产；这里回答“这个工具归谁、入口在哪、配置在哪”。"
      }},
      mcp: {{
        title: "MCP",
        subtitle: "同时看 MCP 总账、宿主配置和连接状态，先对账，再排查。"
      }},
      entrypoints: {{
        title: "入口",
        subtitle: "Agent 应该调用的稳定命令和 wrapper；这里专门排查 PATH、坏链、归属不清。"
      }},
      discovered: {{
        title: "待处理",
        subtitle: "把候选工具真正处理掉，而不是只看见它们。"
      }},
      skills: {{
        title: "技能",
        subtitle: "统计本机 skill 根目录、真实去重数量和路径数量，解释 Finder 里替身为什么看起来很多。"
      }},
      config: {{
        title: "配置",
        subtitle: "本机规则、总账、宿主配置和启动文件的位置；新 Agent 接入时先从这里找源头。"
      }}
    }};
    const scanTabs = new Set(["overview", "discovered"]);
    const searchTabs = new Set(["assets", "mcp", "entrypoints", "skills", "config"]);
    const hashTabs = {{
      overview: "overview",
      mcp: "mcp",
      "mcp-health": "mcp",
      "mcp-host-only": "mcp",
      "mcp-registry-only": "mcp",
      discovered: "discovered",
      "discovered-pending": "discovered",
      assets: "assets",
      entrypoints: "entrypoints",
      skills: "skills",
      config: "config"
    }};

    function activate(tab) {{
      buttons.forEach((button) => button.classList.toggle("active", button.dataset.tab === tab));
      sections.forEach((section) => section.classList.toggle("active", section.dataset.section === tab));
      const copy = tabCopy[tab] || tabCopy.overview;
      if (pageTitle) pageTitle.textContent = copy.title;
      if (pageSubtitle) pageSubtitle.textContent = copy.subtitle;
      if (scanAction) scanAction.hidden = !scanTabs.has(tab);
      if (search) {{
        search.hidden = !searchTabs.has(tab);
        if (search.hidden) search.value = "";
      }}
      filter();
    }}

    function activateFromHash() {{
      const raw = location.hash ? location.hash.slice(1) : "overview";
      const tab = hashTabs[raw] || raw || "overview";
      if (!buttons.some((button) => button.dataset.tab === tab)) {{
        activate("overview");
        return;
      }}
      activate(tab);
      if (raw && raw !== tab) {{
        requestAnimationFrame(() => {{
          const target = document.getElementById(raw);
          if (target) target.scrollIntoView({{ block: "start", behavior: "smooth" }});
        }});
      }}
    }}

    function filter() {{
      const active = document.querySelector(".section.active");
      if (!active) return;
      const query = (search.value || "").trim().toLowerCase();
      const activeFilter = active.dataset.activeFilter || "";
      const items = Array.from(active.querySelectorAll(".searchable"));
      let visible = 0;
      items.forEach((item) => {{
        const text = (item.dataset.text || item.textContent || "").toLowerCase();
        const tags = (item.dataset.filterTags || "").toLowerCase();
        const queryMatch = !query || text.includes(query);
        const filterMatch = !activeFilter || tags.split(/\s+/).includes(activeFilter.toLowerCase());
        const show = queryMatch && filterMatch;
        item.style.display = show ? "" : "none";
        if (show) visible += 1;
      }});
      const empty = active.querySelector(".empty");
      if (empty) empty.style.display = items.length && !visible ? "block" : "none";
    }}

    buttons.forEach((button) => button.addEventListener("click", () => activate(button.dataset.tab)));
    search.addEventListener("input", filter);
    filterButtons.forEach((button) => {{
      button.addEventListener("click", () => {{
        const section = document.querySelector(`.section[data-section="${{button.dataset.filterSection}}"]`);
        if (!section) return;
        section.dataset.activeFilter = button.dataset.filter || "";
        section.querySelectorAll(".filter-chip").forEach((item) => item.classList.toggle("active", item === button));
        filter();
      }});
    }});
    scanButtons.forEach((scanButton) => {{
      if (scanButton.dataset.live !== "true") return;
      scanButton.addEventListener("click", async () => {{
        const mode = scanButton.dataset.mode || "daily";
        scanButtons.forEach((button) => button.disabled = true);
        scanStatus.textContent = mode === "deep" ? "正在运行深度盘点，刷新 MCP 状态..." : "正在刷新日常扫描，刷新 MCP 状态...";
        try {{
          const response = await fetch(`/api/scan?mode=${{encodeURIComponent(mode)}}`, {{ method: "POST" }});
          if (!response.ok) throw new Error(await response.text());
          const result = await response.json();
          scanStatus.textContent = `体检完成（${{result.scan_mode}}）：${{result.candidates}} 个候选，${{result.unregistered}} 个未登记。正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          scanStatus.textContent = `扫描失败：${{error.message || error}}`;
          scanButtons.forEach((button) => button.disabled = false);
        }}
      }});
    }});
    async function postJson(url, payload, button) {{
      if (button) {{
        button.disabled = true;
        button.dataset.originalText = button.textContent;
        button.textContent = "处理中";
      }}
      const response = await fetch(url, {{
        method: "POST",
        headers: {{ "Content-Type": "application/json" }},
        body: JSON.stringify(payload || {{}})
      }});
      if (!response.ok) throw new Error(await response.text());
      return await response.json();
    }}
    function resetActionButton(button) {{
      if (!button) return;
      button.disabled = false;
      if (button.dataset.originalText) button.textContent = button.dataset.originalText;
    }}
    document.querySelectorAll(".js-review").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/review", {{ path: button.dataset.path, status: button.dataset.status }}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `更新处理状态失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-register-candidate").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/register-candidate", {{ path: button.dataset.path }}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `登记候选项失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-register-mcp").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/register-mcp", {{ location: button.dataset.location }}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `纳入 MCP 总账失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-register-all-mcp").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/register-mcp-bulk", {{}}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `批量纳入 MCP 失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    window.addEventListener("hashchange", activateFromHash);
    activateFromHash();
  </script>
</body>
</html>
"""


def build_dashboard(run_discovery=True, refresh_mcp=True, live=False, discovery_mode="daily"):
    agent_registry = load_json(REGISTRY)
    mcp_registry = load_json(MCP_REGISTRY)
    discovery_raw = refresh_discovery(mode=discovery_mode) if run_discovery else ""
    discovered_rows, discovered_at, discovered_meta = collect_discovered()
    if refresh_mcp:
        health, health_raw = parse_claude_mcp_health()
    else:
        health, health_raw = cached_mcp_health("MCP health cache. Click one-key scan to refresh.")
    mcp_rows = collect_mcp(mcp_registry, health)
    mcp_audit = build_mcp_audit(agent_registry, mcp_registry, mcp_rows)
    entrypoints = collect_entrypoints(agent_registry)
    skill_rows, skill_totals = collect_skills(agent_registry)
    html_text = build_html(
        agent_registry,
        mcp_registry,
        mcp_rows,
        entrypoints,
        skill_rows,
        skill_totals,
        health_raw,
        discovered_rows,
        discovered_at,
        discovery_raw,
        mcp_audit,
        discovered_meta,
        live=live,
    )
    summary = {
        "assets": len(agent_registry.get("assets", {})),
        "mcp_total": len(mcp_rows),
        "mcp_connected": sum(1 for row in mcp_rows if row["state"] == "connected"),
        "entrypoints": len(entrypoints),
        "valid_entrypoints": sum(1 for row in entrypoints if row["state"] in {"exec", "file", "dir"}),
        "candidates": len(discovered_rows),
        "unregistered": sum(1 for row in discovered_rows if not row.get("registered")),
        "needs_review": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status", "new") == "new"),
        "deferred": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "defer"),
        "ignored": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "ignore"),
        "skills_unique": skill_totals.get("unique", 0),
        "skills_paths": skill_totals.get("paths", 0),
        "skills_recursive_paths": skill_totals.get("recursive_paths", 0),
        "skills_recursive_unique": skill_totals.get("recursive_unique", 0),
        "skills_aliases": skill_totals.get("aliases", 0),
        "skills_nested": skill_totals.get("nested", 0),
        "discovered_at": discovered_at,
        "scan_mode": discovered_meta.get("scan_mode", "daily"),
        "mcp_host_only": mcp_audit["summary"]["host_only"],
        "mcp_registry_only": mcp_audit["summary"]["registry_only"],
    }
    return html_text, summary


def write_dashboard(run_discovery=True, refresh_mcp=True, live=False):
    html_text, summary = build_dashboard(run_discovery=run_discovery, refresh_mcp=refresh_mcp, live=live)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(html_text, encoding="utf-8")
    return summary


def run_scan(include_versions=False, mode="daily"):
    discovery_raw = refresh_discovery(include_versions=include_versions, mode=mode)
    discovered_rows, discovered_at, discovered_meta = collect_discovered()
    mcp_registry = load_json(MCP_REGISTRY)
    health, health_raw = parse_claude_mcp_health()
    mcp_rows = collect_mcp(mcp_registry, health)
    write_dashboard(run_discovery=False, refresh_mcp=False, live=False)
    return {
        "ok": True,
        "updated_at": discovered_at,
        "scan_mode": discovered_meta.get("scan_mode", mode),
        "candidates": len(discovered_rows),
        "unregistered": sum(1 for row in discovered_rows if not row.get("registered")),
        "needs_review": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status", "new") == "new"),
        "deferred": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "defer"),
        "ignored": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "ignore"),
        "mcp_total": len(mcp_rows),
        "mcp_connected": sum(1 for row in mcp_rows if row["state"] == "connected"),
        "discovery_output": discovery_raw,
        "mcp_output": health_raw,
    }


class DashboardHandler(http.server.BaseHTTPRequestHandler):
    server_version = "AgentAssetsDashboard/1.0"

    def send_text(self, text, content_type="text/plain; charset=utf-8", status=200, include_body=True):
        data = text.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if include_body:
            self.wfile.write(data)

    def send_json(self, payload, status=200):
        self.send_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", "application/json; charset=utf-8", status)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in {"/", "/dashboard.html"}:
            html_text, _summary = build_dashboard(run_discovery=False, refresh_mcp=False, live=True)
            self.send_text(html_text, "text/html; charset=utf-8")
            return
        if parsed.path == "/favicon.ico":
            self.send_text("", "image/x-icon", status=204)
            return
        if parsed.path == "/api/status":
            _html_text, summary = build_dashboard(run_discovery=False, refresh_mcp=False, live=True)
            self.send_json(summary)
            return
        self.send_json({"ok": False, "error": "not found"}, status=404)

    def do_HEAD(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in {"/", "/dashboard.html"}:
            html_text, _summary = build_dashboard(run_discovery=False, refresh_mcp=False, live=True)
            self.send_text(html_text, "text/html; charset=utf-8", include_body=False)
            return
        if parsed.path == "/api/status":
            _html_text, summary = build_dashboard(run_discovery=False, refresh_mcp=False, live=True)
            self.send_text(json.dumps(summary, ensure_ascii=False) + "\n", "application/json; charset=utf-8", include_body=False)
            return
        self.send_text("", status=404, include_body=False)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/api/scan":
            query = urllib.parse.parse_qs(parsed.query)
            include_versions = query.get("versions", ["0"])[0] in {"1", "true", "yes"}
            mode = query.get("mode", ["daily"])[0]
            if mode not in {"daily", "deep"}:
                mode = "daily"
            try:
                self.send_json(run_scan(include_versions=include_versions, mode=mode))
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        length = int(self.headers.get("Content-Length", "0") or "0")
        raw_body = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(raw_body.decode("utf-8") or "{}")
        except json.JSONDecodeError:
            payload = {}
        if parsed.path == "/api/review":
            path_value = str(payload.get("path") or "")
            status = str(payload.get("status") or "")
            if not path_value or status not in {"new", "defer", "ignore"}:
                self.send_json({"ok": False, "error": "invalid review payload"}, status=400)
                return
            try:
                save_review_decision(path_value, status)
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, live=False)
                self.send_json({"ok": True, "path": path_value, "status": status})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/register-candidate":
            path_value = str(payload.get("path") or "")
            if not path_value:
                self.send_json({"ok": False, "error": "missing candidate path"}, status=400)
                return
            try:
                register_discovered_candidate(path_value)
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, live=False)
                self.send_json({"ok": True, "path": path_value})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/register-mcp":
            location = str(payload.get("location") or "")
            if not location:
                self.send_json({"ok": False, "error": "missing mcp location"}, status=400)
                return
            try:
                register_mcp_from_host(location)
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, live=False)
                self.send_json({"ok": True, "location": location})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/register-mcp-bulk":
            try:
                locations = register_all_host_only_mcp()
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, live=False)
                self.send_json({"ok": True, "locations": locations, "count": len(locations)})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        self.send_json({"ok": False, "error": "not found"}, status=404)

    def log_message(self, format, *args):
        sys.stderr.write("asset-dashboard: " + (format % args) + "\n")


def serve_dashboard(port, open_browser=False):
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), DashboardHandler)
    url = f"http://127.0.0.1:{port}/"
    write_dashboard(run_discovery=True, refresh_mcp=False, live=False)
    print(url)
    if open_browser:
        subprocess.run(["/usr/bin/open", url], check=False)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(description="Generate or serve the local Agent Assets dashboard.")
    parser.add_argument("--open", action="store_true", help="Open the generated dashboard in the default browser")
    parser.add_argument("--serve", action="store_true", help="Run a local dashboard server with one-click scan support")
    parser.add_argument("--port", type=int, default=int(os.environ.get("AGENT_ASSETS_PORT", "17654")), help="Local dashboard server port")
    args = parser.parse_args()

    if args.serve:
        serve_dashboard(args.port, open_browser=args.open)
        return

    write_dashboard(run_discovery=True, refresh_mcp=True, live=False)
    print(str(OUT))

    if args.open:
        subprocess.run(["/usr/bin/open", str(OUT)], check=False)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"asset-dashboard failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
