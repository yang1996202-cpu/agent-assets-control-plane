#!/usr/bin/env python3
import argparse
import datetime as dt
import http.server
import html
import json
import os
import pathlib
import subprocess
import sys
import urllib.parse

HOME = pathlib.Path(os.environ.get("AGENT_ASSETS_USER_HOME", str(pathlib.Path.home()))).expanduser()
CONFIG_HOME = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", str(HOME / ".config"))).expanduser()
ASSETS_HOME = pathlib.Path(os.environ.get("AGENT_ASSETS_HOME", str(CONFIG_HOME / "agent-assets"))).expanduser()
MCP_HOME = pathlib.Path(os.environ.get("AGENT_ASSETS_MCP_HOME", str(CONFIG_HOME / "mcp"))).expanduser()
STABLE_BIN_DIR = pathlib.Path(os.environ.get("AGENT_ASSETS_BIN_DIR", str(HOME / ".local/bin"))).expanduser()
PROJECTS_DIR = pathlib.Path(os.environ.get("AGENT_ASSETS_PROJECTS_DIR", str(HOME / "projects"))).expanduser()
SCRIPT_DIR = pathlib.Path(__file__).resolve().parent

REGISTRY = pathlib.Path(os.environ.get("AGENT_ASSETS_REGISTRY", str(ASSETS_HOME / "registry.json"))).expanduser()
MCP_REGISTRY = pathlib.Path(os.environ.get("AGENT_ASSETS_MCP_REGISTRY", str(MCP_HOME / "registry.json"))).expanduser()
DISCOVERED = pathlib.Path(os.environ.get("AGENT_ASSETS_DISCOVERED", str(ASSETS_HOME / "discovered.json"))).expanduser()
MCP_HEALTH_CACHE = pathlib.Path(os.environ.get("AGENT_ASSETS_MCP_HEALTH_CACHE", str(ASSETS_HOME / "mcp-health-cache.json"))).expanduser()
OUT = pathlib.Path(os.environ.get("AGENT_ASSETS_DASHBOARD_HTML", str(ASSETS_HOME / "dashboard.html"))).expanduser()
START_FILE = pathlib.Path(os.environ.get("AGENT_ASSETS_START_FILE", str(HOME / "AGENT_START_HERE.md"))).expanduser()
CLAUDE = pathlib.Path(os.environ.get("AGENT_ASSETS_CLAUDE", str(STABLE_BIN_DIR / "claude"))).expanduser()
ASSET_DISCOVER = pathlib.Path(os.environ.get("AGENT_ASSETS_DISCOVER_CMD", str(STABLE_BIN_DIR / "agent-assets-discover"))).expanduser()
if not ASSET_DISCOVER.exists():
    repo_local_discover = SCRIPT_DIR / "agent-assets-discover"
    legacy_discover = STABLE_BIN_DIR / "asset-discover"
    if repo_local_discover.exists():
        ASSET_DISCOVER = repo_local_discover
    elif legacy_discover.exists():
        ASSET_DISCOVER = legacy_discover


def load_json(path):
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def h(value):
    return html.escape(str(value), quote=True)


def href_for_path(value):
    path = path_part(value)
    if not path:
        return ""
    return "file://" + urllib.parse.quote(str(path))


def path_part(value):
    if not value or not str(value).startswith("/"):
        return None
    raw = str(value)
    if pathlib.Path(raw).exists() or pathlib.Path(raw).is_symlink():
        return raw
    for idx, char in enumerate(raw):
        if char != ":":
            continue
        candidate = raw[:idx]
        if pathlib.Path(candidate).exists() or pathlib.Path(candidate).is_symlink():
            return candidate
    return raw


def path_state(value):
    path_value = path_part(value)
    if not path_value:
        return "ref"
    path = pathlib.Path(path_value)
    if path.exists():
        if path_value != str(value):
            return "file-ref"
        if path.is_dir():
            return "dir"
        if os.access(path, os.X_OK):
            return "exec"
        return "file"
    if path.is_symlink():
        return "broken-link"
    return "missing"


def chip(value, css_class=""):
    value = str(value)
    state = path_state(value)
    href = href_for_path(value)
    label = h(value)
    state_label = h(state)
    classes = "chip " + h(css_class)
    if href:
        return f'<a class="{classes}" href="{h(href)}"><span>{label}</span><b>{state_label}</b></a>'
    return f'<span class="{classes}"><span>{label}</span><b>{state_label}</b></span>'


def listify(value):
    if not value:
        return []
    if isinstance(value, list):
        return [str(v) for v in value if v is not None]
    return [str(value)]


def collect_entrypoints(agent_registry):
    owners = {}
    categories = {}
    assets = agent_registry.get("assets", {})
    for asset_id, asset in assets.items():
        for entry in listify(asset.get("stable_entrypoints")):
            owners.setdefault(entry, []).append(asset_id)
            categories.setdefault(entry, set()).update(asset.get("category", []))

    known = agent_registry.get("indexes", {}).get("stable_bin_dir", {}).get("current_known_agent_entrypoints", [])
    for entry in known:
        owners.setdefault(entry, [])

    rows = []
    for entry, owner_list in sorted(owners.items()):
        rows.append({
            "path": entry,
            "state": path_state(entry),
            "owners": sorted(owner_list),
            "kind": entrypoint_kind(entry, categories.get(entry, set())),
        })
    return rows


def entrypoint_kind(entry, categories):
    name = pathlib.Path(entry).name
    if str(entry).endswith(".app"):
        return "app"
    if name.endswith("-mcp") or "mcp" in categories:
        return "mcp-wrapper"
    if "agent-host" in categories:
        return "agent-command"
    if "dashboard" in categories:
        return "dashboard"
    if "package-manager" in categories or "cli-runtime" in categories:
        return "runtime"
    return "cli"


def collect_skills(agent_registry):
    roots = agent_registry.get("indexes", {}).get("skill_roots", {})
    rows = []
    all_recursive_files = []
    all_direct_files = []
    global_recursive_identities = set()
    global_direct_identities = set()
    for name, root in sorted(roots.items()):
        root_path = pathlib.Path(root)
        recursive_files = []
        direct_files = []
        if root_path.exists():
            try:
                recursive_files = sorted(root_path.rglob("SKILL.md"), key=lambda p: str(p).lower())
            except OSError:
                recursive_files = []
            try:
                if (root_path / "SKILL.md").exists():
                    direct_files.append(root_path / "SKILL.md")
                for child in sorted(root_path.iterdir(), key=lambda p: p.name.lower()):
                    if child.is_dir() and (child / "SKILL.md").exists():
                        direct_files.append(child / "SKILL.md")
            except OSError:
                direct_files = []
        recursive_identity_map = {}
        direct_identity_map = {}
        for skill_file in recursive_files:
            try:
                identity = str(skill_file.resolve())
            except OSError:
                identity = str(skill_file)
            recursive_identity_map.setdefault(identity, []).append(str(skill_file))
            global_recursive_identities.add(identity)
            all_recursive_files.append(str(skill_file))
        for skill_file in direct_files:
            try:
                identity = str(skill_file.resolve())
            except OSError:
                identity = str(skill_file)
            direct_identity_map.setdefault(identity, []).append(str(skill_file))
            global_direct_identities.add(identity)
            all_direct_files.append(str(skill_file))
        direct_count = len(direct_files)
        direct_unique_count = len(direct_identity_map)
        recursive_count = len(recursive_files)
        recursive_unique_count = len(recursive_identity_map)
        rows.append({
            "name": name,
            "root": root,
            "count": direct_count,
            "unique_count": direct_unique_count,
            "recursive_count": recursive_count,
            "recursive_unique_count": recursive_unique_count,
            "nested_count": max(0, recursive_count - direct_count),
            "alias_count": max(0, recursive_count - recursive_unique_count),
            "examples": [str(p) for p in direct_files[:6]],
            "state": path_state(root),
        })
    totals = {
        "paths": len(all_direct_files),
        "unique": len(global_direct_identities),
        "recursive_paths": len(all_recursive_files),
        "recursive_unique": len(global_recursive_identities),
        "aliases": len(all_recursive_files) - len(global_recursive_identities),
        "nested": max(0, len(all_recursive_files) - len(all_direct_files)),
    }
    return rows, totals


def parse_health_text(combined):
    health = {}
    for raw_line in combined.splitlines():
        line = raw_line.strip()
        if ": " not in line or " - " not in line:
            continue
        name = line.split(":", 1)[0].strip()
        status = line.rsplit(" - ", 1)[-1].strip()
        if "Connected" in status:
            health[name] = {"state": "connected", "label": status}
        elif "Failed" in status:
            health[name] = {"state": "failed", "label": status}
        else:
            health[name] = {"state": "unknown", "label": status}
    return health


def cached_mcp_health(prefix):
    if not MCP_HEALTH_CACHE.exists():
        return {}, prefix
    try:
        data = load_json(MCP_HEALTH_CACHE)
    except Exception:
        return {}, prefix
    raw = data.get("raw", "")
    health = data.get("health", {})
    updated = data.get("updated_at", "unknown")
    return health, f"{prefix}\nShowing cached MCP health from {updated}.\n\n{raw}".strip()


def parse_claude_mcp_health():
    if not CLAUDE.exists():
        return cached_mcp_health("claude command missing")
    try:
        proc = subprocess.run(
            [str(CLAUDE), "mcp", "list"],
            cwd=str(HOME),
            capture_output=True,
            text=True,
            timeout=8,
        )
    except subprocess.TimeoutExpired:
        return cached_mcp_health("claude mcp list timed out after 8s")
    except OSError as exc:
        return cached_mcp_health(str(exc))

    combined = (proc.stdout or "") + "\n" + (proc.stderr or "")
    health = parse_health_text(combined)
    try:
        MCP_HEALTH_CACHE.write_text(
            json.dumps(
                {
                    "updated_at": dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    "health": health,
                    "raw": combined.strip(),
                },
                ensure_ascii=False,
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
    except OSError:
        pass
    return health, combined.strip()


def collect_mcp(mcp_registry, health):
    rows = []
    for name, server in sorted(mcp_registry.get("stdio_servers", {}).items()):
        rows.append({
            "name": name,
            "kind": "stdio",
            "entry": server.get("wrapper") or server.get("underlying") or server.get("package_path") or "",
            "hosts": listify(server.get("hosts")),
            "state": health.get(name, {}).get("state", "registered"),
            "health": health.get(name, {}).get("label", "registered"),
            "note": server.get("status_note") or "",
        })
    for name, server in sorted(mcp_registry.get("http_servers", {}).items()):
        rows.append({
            "name": name,
            "kind": "http",
            "entry": server.get("url") or "",
            "hosts": listify(server.get("hosts")),
            "state": health.get(name, {}).get("state", "registered"),
            "health": health.get(name, {}).get("label", "registered"),
            "note": server.get("secret_location") or "",
        })
    for name, server in sorted(mcp_registry.get("internal_servers", {}).items()):
        rows.append({
            "name": name,
            "kind": "internal",
            "entry": server.get("command") or "",
            "hosts": listify(server.get("host")),
            "state": "internal",
            "health": "internal",
            "note": server.get("note") or "",
        })
    return rows


def refresh_discovery(include_versions=False, mode="daily"):
    if not ASSET_DISCOVER.exists():
        return ""
    try:
        command = [str(ASSET_DISCOVER), "--mode", mode]
        if include_versions:
            command.append("--versions")
        proc = subprocess.run(
            command,
            cwd=str(HOME),
            capture_output=True,
            text=True,
            timeout=20,
        )
        return ((proc.stdout or "") + "\n" + (proc.stderr or "")).strip()
    except Exception as exc:
        return f"asset-discover failed: {exc}"


def collect_discovered():
    data = load_json(DISCOVERED)
    return data.get("candidates", []), data.get("updated_at", ""), data


def render_chips(values, css_class=""):
    values = listify(values)
    if not values:
        return '<span class="muted">无</span>'
    return "\n".join(chip(v, css_class) for v in values)


def render_asset_cards(agent_registry):
    cards = []
    for asset_id, asset in sorted(agent_registry.get("assets", {}).items()):
        categories = ", ".join(asset.get("category", [])) or "未分类"
        refs = []
        for key in ("stable_entrypoints", "mcp_urls", "config_paths", "data_paths", "source_paths", "project_paths", "skill_roots", "registries"):
            values = listify(asset.get(key))
            if values:
                refs.append(f'<div class="asset-row"><strong>{h(key)}</strong><div>{render_chips(values)}</div></div>')
        status = asset.get("status") or ""
        cards.append(f"""
        <article class="asset-card searchable" data-section="assets" data-text="{h(asset_id)} {h(categories)} {h(json.dumps(asset, ensure_ascii=False))}">
          <div class="asset-head">
            <div>
              <h3>{h(asset_id)}</h3>
              <p>{h(categories)}</p>
            </div>
            <span class="badge">{h(asset.get("category", ["资产"])[0]) if asset.get("category") else "资产"}</span>
          </div>
          {'<p class="status-text">' + h(status) + '</p>' if status else ''}
          <div class="asset-refs">
            {''.join(refs)}
          </div>
        </article>
        """)
    return "\n".join(cards)


def state_badge(state, label=None):
    state_labels = {
        "registered": "已登记",
        "connected": "已连接",
        "failed": "失败",
        "unknown": "未知",
        "internal": "内部",
        "exec": "可执行",
        "file": "文件",
        "dir": "目录",
        "file-ref": "文件引用",
        "ref": "引用",
        "missing": "缺失",
        "broken-link": "坏链",
        "new": "待处理",
        "defer": "稍后处理",
        "ignore": "已忽略",
        "app": "应用",
        "mcp-wrapper": "MCP 包装器",
        "agent-command": "Agent 命令",
        "dashboard": "面板",
        "runtime": "运行时",
        "cli": "CLI",
    }
    raw_text = label or state
    text = state_labels.get(raw_text, state_labels.get(state, raw_text))
    normalized = state.replace("_", "-")
    return f'<span class="state state-{h(normalized)}">{h(text)}</span>'


def render_mcp_rows(rows):
    out = []
    for row in rows:
        out.append(f"""
        <tr class="searchable" data-section="mcp" data-text="{h(json.dumps(row, ensure_ascii=False))}">
          <td><strong>{h(row["name"])}</strong><span class="subtle">{h(row["kind"])}</span></td>
          <td>{chip(row["entry"])}</td>
          <td>{state_badge(row["state"], row["health"])}</td>
          <td>{render_chips(row["hosts"])}</td>
          <td class="note-cell">{h(row["note"])}</td>
        </tr>
        """)
    return "\n".join(out)


def render_entrypoint_rows(rows):
    out = []
    for row in rows:
        owner_text = ", ".join(row["owners"]) if row["owners"] else "未登记归属"
        out.append(f"""
        <tr class="searchable" data-section="entrypoints" data-text="{h(row["path"])} {h(owner_text)} {h(row["state"])} {h(row["kind"])}">
          <td>{chip(row["path"])}</td>
          <td>{state_badge(row["kind"])}</td>
          <td>{state_badge(row["state"])}</td>
          <td>{h(owner_text)}</td>
        </tr>
        """)
    return "\n".join(out)


def render_skill_rows(rows):
    out = []
    for row in rows:
        examples = render_chips(row["examples"])
        alias = ""
        if row.get("nested_count"):
            alias = f' <span class="count-pill">{row["nested_count"]} 嵌套/递归</span>'
        out.append(f"""
        <tr class="searchable" data-section="skills" data-text="{h(json.dumps(row, ensure_ascii=False))}">
          <td><strong>{h(row["name"])}</strong></td>
          <td>{chip(row["root"])}</td>
          <td>{state_badge(row["state"])} <span class="count-pill">{row["unique_count"]} 顶层</span> <span class="count-pill">{row["recursive_count"]} 递归</span>{alias}</td>
          <td>{examples}</td>
        </tr>
        """)
    return "\n".join(out)


def render_config_rows(agent_registry):
    configs = []
    configs.append(("start file", str(START_FILE)))
    for key, value in agent_registry.get("policy", {}).items():
        if isinstance(value, str) and value.startswith("/"):
            configs.append((key, value))
    for key, value in agent_registry.get("indexes", {}).get("host_configs", {}).items():
        configs.append((key, value))
    out = []
    seen = set()
    for label, value in configs:
        if value in seen:
            continue
        seen.add(value)
        out.append(f"""
        <tr class="searchable" data-section="config" data-text="{h(label)} {h(value)}">
          <td><strong>{h(label)}</strong></td>
          <td>{chip(value)}</td>
          <td>{state_badge(path_state(value))}</td>
        </tr>
        """)
    return "\n".join(out)


def render_discovered_rows(rows, empty_label="没有匹配的候选项。"):
    out = []
    for row in rows:
        cats = ", ".join(row.get("categories", []))
        owners = ", ".join(row.get("owners", [])) or "unregistered"
        state = "registered" if row.get("registered") else row.get("review_status", "new")
        version = row.get("version") or ""
        review_bits = [state_badge(state)]
        if row.get("review_action"):
            review_bits.append(f'<span class="subtle">{h(row.get("review_action"))}</span>')
        if row.get("review_note"):
            review_bits.append(f'<span class="subtle">{h(row.get("review_note"))}</span>')
        out.append(f"""
        <tr class="searchable" data-section="discovered" data-text="{h(json.dumps(row, ensure_ascii=False))}">
          <td><strong>{h(row.get("name", ""))}</strong><span class="subtle">{h(cats)}</span></td>
          <td>{chip(row.get("path", ""))}<span class="subtle">{h(row.get("package_hint") or "")}</span></td>
          <td>{state_badge(state)}<span class="subtle">{h(owners)}</span></td>
          <td>{''.join(review_bits)}</td>
          <td>{h(version)}</td>
        </tr>
        """)
    if out:
        return "\n".join(out)
    return f'<tr><td colspan="5" class="muted">{h(empty_label)}</td></tr>'


def discovered_table(rows, empty_label):
    return f"""
        <table>
          <thead><tr><th>名称</th><th>路径</th><th>登记状态</th><th>处理状态</th><th>版本</th></tr></thead>
          <tbody>{render_discovered_rows(rows, empty_label)}</tbody>
        </table>
    """


