#!/usr/bin/env python3
import argparse
import os
import pathlib
import sys

_SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
_LIB_CANDIDATES = [
    os.environ.get("AGENT_ASSETS_LIB_DIR"),
    str(_SCRIPT_DIR.parent / "lib"),
    str(pathlib.Path.home() / ".local/lib/agent-assets"),
]
for _P in _LIB_CANDIDATES:
    if _P and _P not in sys.path:
        sys.path.insert(0, _P)
import agent_assets_common as lib
import agent_assets_dashboard_api as api
import agent_assets_dashboard_html as html_module
import agent_assets_dashboard_paths as paths


def main():
    parser = argparse.ArgumentParser(description="Generate or serve the local Agent Assets dashboard.")
    parser.add_argument("--open", action="store_true", help="Open the generated dashboard in the default browser")
    parser.add_argument("--serve", action="store_true", help="Run a local dashboard server with one-click scan support")
    parser.add_argument(
        "--port",
        type=int,
        default=int(os.environ.get("AGENT_ASSETS_PORT", "17654")),
        help="Local dashboard server port",
    )
    args = parser.parse_args()

    if args.serve:
        api.serve(host="127.0.0.1", port=args.port, open_browser=args.open)
        return

    html_module.write_dashboard(run_discovery=True, refresh_mcp=True, live=False)
    print(str(paths.OUT))

    if args.open:
        import subprocess

        subprocess.run(["/usr/bin/open", str(paths.OUT)], check=False)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"asset-dashboard failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
