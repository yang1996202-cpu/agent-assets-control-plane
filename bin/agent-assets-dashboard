        "connected": "已连接",
        "failed": "失败",
        "unknown": "未知",
        "internal": "内部",
        "exec": "可执行",
        "file": "文件",
        "dir": "目录",
        "file-ref": "文件引用",
        "ref": "引用",
        "missing": "缺失",
        "broken-link": "坏链",
        "new": "待处理",
        "defer": "稍后处理",
        "ignore": "已忽略",
        "app": "应用",
        "mcp-wrapper": "MCP 包装器",
        "agent-command": "Agent 命令",
        "dashboard": "面板",
        "runtime": "运行时",
        "cli": "CLI",
        "canonical": "标准项目",
        "legacy": "旧位置",
        "download_candidate": "下载候选",
        "host_managed": "宿主管理",
        "registered_source": "已登记源码",
        "manual": "手动根目录",
        "linked": "已关联资产",
        "git-repo": "Git 仓库",
        "node-package": "Node 包",
        "python-package": "Python 包",
        "go-module": "Go 模块",
        "rust-package": "Rust 包",
        "skill": "Skill",
        "mcp-candidate": "MCP 候选",
        "cli-candidate": "CLI 候选",
        "documentation": "文档项目",
        "enabled": "已启用",
        "disabled": "已关闭",
        "running": "运行中",
        "not-running": "未运行",
        "listening": "监听端口",
        "privileged": "高权限",
        "attention": "需关注",
        "residual-candidate": "残留候选",
