        "broken-link": "坏链",
        "new": "待处理",
        "defer": "稍后处理",
        "ignore": "已忽略",
        "app": "应用",
        "mcp-wrapper": "MCP 包装器",
        "agent-command": "Agent 命令",
        "dashboard": "面板",
        "runtime": "运行时",
        "cli": "CLI",
        "canonical": "标准项目",
        "legacy": "旧位置",
        "download_candidate": "下载候选",
        "host_managed": "宿主管理",
        "registered_source": "已登记源码",
        "manual": "手动根目录",
        "linked": "已关联资产",
