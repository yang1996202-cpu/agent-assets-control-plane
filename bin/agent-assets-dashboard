      width: 34px; height: 34px; border-radius: 8px;
      background: #20242a; color: white; display: grid; place-items: center;
      font-weight: 700;
    }}
    .nav button {{
      width: 100%;
      border: 0;
      background: transparent;
      padding: 10px 12px;
      border-radius: 8px;
      text-align: left;
      color: var(--text);
      font: inherit;
      cursor: pointer;
      margin-bottom: 4px;
    }}
    .nav button.active {{ background: #eceee8; font-weight: 650; }}
    .meta {{ margin-top: 20px; font-size: 12px; color: var(--muted); line-height: 1.5; }}
