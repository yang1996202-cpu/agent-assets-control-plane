        <div class="issue-list">
          {"".join(
              f'<div class="issue-row searchable" data-section="discovered" data-text="{h(text)}">'
              f'<div class="issue-main">{state_badge(state)}<p>{h(text)}</p></div>'
              f'<div class="issue-actions"><a class="jump-link js-jump" href="{h(target)}">{h(label)}</a></div></div>'
              for state, text, target, label in overview_issues
          ) if overview_issues else '<div class="issue-row"><div class="issue-main">' + state_badge('registered', '已清空') + '<p>当前没有跨来源待办。</p></div></div>'}
        </div>
        <h2>候选工具</h2>
        <p>候选工具只是一类待办。每个候选项都应该有决定：登记、稍后、忽略。</p>
        <p>当前模式：{h(scan_mode_label)}。当前：{needs_review_count} 个待处理 / {deferred_count} 个稍后处理 / {ignored_count} 个已忽略 / 共 {unregistered_count} 个未登记。</p>
        {render_discovered_filters(discovered_rows)}
        <details>
          <summary>本次扫描目录（{len(scan_dirs)} 个）</summary>
          <div>{render_chips(scan_dirs)}</div>
        </details>
        <h3 id="discovered-pending">待我处理</h3>
        {discovered_table(pending_rows, "当前没有待确认候选项。")}
        <h3>已登记或稍后</h3>
        {discovered_table(registered_rows + deferred_rows, "当前没有已登记或稍后处理候选项。")}
        <h3>已忽略</h3>
        {discovered_table(ignored_rows, "当前没有已忽略候选项。")}
      </section>

      <section class="section" data-section="skills">
        <h2>技能根目录</h2>
        <p>主数字按顶层技能库统计；递归数量只用于诊断嵌套副本、宿主镜像和 symlink，不再当成真实可用技能数。</p>
        {render_skill_filters(skill_rows)}
        <table>
          <thead><tr><th>根目录</th><th>路径</th><th>数量</th><th>示例</th></tr></thead>
          <tbody>{render_skill_rows(skill_rows)}</tbody>
        </table>
        <div class="empty">没有匹配的 skill。</div>
      </section>

      <section class="section" data-section="config">
        <h2>设置 / 规则</h2>
        <p>这里列出本机 Agent 资产规范、MCP 总账、宿主配置和启动文件，方便排查“规则到底写在哪里”。</p>
        {render_config_filters(agent_registry)}
        <table>
          <thead><tr><th>名称</th><th>路径</th><th>状态</th></tr></thead>
          <tbody>{render_config_rows(agent_registry)}</tbody>
        </table>
        <div class="empty">没有匹配的配置。</div>
      </section>
    </main>
  </div>
  <script>
    const buttons = Array.from(document.querySelectorAll("[data-tab]"));
    const sections = Array.from(document.querySelectorAll(".section"));
    const search = document.getElementById("search");
    const pageTitle = document.getElementById("pageTitle");
    const pageSubtitle = document.getElementById("pageSubtitle");
    const scanAction = document.getElementById("scanAction");
    const scanButtons = Array.from(document.querySelectorAll(".scan-button"));
    const scanStatus = document.getElementById("scanStatus");
    const projectButtons = Array.from(document.querySelectorAll(".project-scan-button"));
    const projectStatus = document.getElementById("projectStatus");
    const macosButtons = Array.from(document.querySelectorAll(".macos-scan-button"));
    const macosStatus = document.getElementById("macosStatus");
    const fullUpdateButtons = Array.from(document.querySelectorAll(".full-update-button"));
    const crosscheckButtons = Array.from(document.querySelectorAll(".crosscheck-button"));
    const filterButtons = Array.from(document.querySelectorAll(".filter-chip"));
    const tabCopy = {{
      overview: {{
        title: "总览",
        subtitle: "先看问题和下一步动作，不在总览里堆列表。"
      }},
      assets: {{
        title: "资产",
        subtitle: "正式登记过的本机 Agent 资产；这里回答“这个工具归谁、入口在哪、配置在哪”。"
      }},
      evidence: {{
        title: "发现",
        subtitle: "所有扫描来源都收在这里。先当证据看，只有处理后才进入正式资产。"
      }},
      mcp: {{
        title: "发现 / MCP",
        subtitle: "MCP 是证据来源之一：同时看总账、宿主配置和连接状态，先对账，再排查。"
      }},
      entrypoints: {{
        title: "发现 / 入口",
        subtitle: "入口是证据来源之一：Agent 应该调用的稳定命令和 wrapper；这里专门排查 PATH、坏链、归属不清。"
      }},
      discovered: {{
        title: "待处理",
        subtitle: "把候选工具真正处理掉，而不是只看见它们。"
      }},
      projects: {{
        title: "发现 / 项目",
        subtitle: "项目是证据来源之一：历史下载、GitHub clone、源码包和宿主管理工作区；先索引，再决定是否收编。"
      }},
      system: {{
        title: "发现 / 系统",
        subtitle: "系统痕迹是证据来源之一：macOS 登录项、后台项、launchd、进程和端口痕迹；先验证，再决定是否清理或入账。"
      }},
      skills: {{
        title: "发现 / 技能",
        subtitle: "技能是证据来源之一：统计本机 skill 根目录、真实去重数量和路径数量，解释 Finder 里替身为什么看起来很多。"
      }},
      config: {{
        title: "设置",
        subtitle: "本机规则、总账、宿主配置和启动文件的位置；新 Agent 接入时先从这里找源头。"
      }}
    }};
    const scanTabs = new Set(["overview", "discovered"]);
    const searchTabs = new Set(["assets", "projects", "system", "mcp", "entrypoints", "skills", "config"]);
    const tabParents = {{
      projects: "evidence",
      system: "evidence",
      mcp: "evidence",
      entrypoints: "evidence",
      skills: "evidence"
    }};
    const hashTabs = {{
      overview: "overview",
      projects: "projects",
      "projects-legacy": "projects",
      system: "system",
      "system-signals": "system",
      mcp: "mcp",
      "mcp-health": "mcp",
      "mcp-host-only": "mcp",
      "mcp-registry-only": "mcp",
      discovered: "discovered",
      "discovered-pending": "discovered",
      assets: "assets",
      evidence: "evidence",
      entrypoints: "entrypoints",
      skills: "skills",
      config: "config"
    }};

    function activate(tab) {{
      const navTab = tabParents[tab] || tab;
      buttons.forEach((button) => button.classList.toggle("active", button.dataset.tab === navTab));
      sections.forEach((section) => section.classList.toggle("active", section.dataset.section === tab));
      const copy = tabCopy[tab] || tabCopy.overview;
      if (pageTitle) pageTitle.textContent = copy.title;
      if (pageSubtitle) pageSubtitle.textContent = copy.subtitle;
      if (scanAction) scanAction.hidden = !scanTabs.has(tab);
      if (search) {{
        search.hidden = !searchTabs.has(tab);
        if (search.hidden) search.value = "";
      }}
      filter();
    }}

    function activateFromHash() {{
      const raw = location.hash ? location.hash.slice(1) : "overview";
      const tab = hashTabs[raw] || raw || "overview";
      if (!sections.some((section) => section.dataset.section === tab)) {{
        activate("overview");
        return;
      }}
      activate(tab);
      if (raw && raw !== tab) {{
        requestAnimationFrame(() => {{
          const target = document.getElementById(raw);
          if (target) target.scrollIntoView({{ block: "start", behavior: "smooth" }});
        }});
      }}
    }}

    function filter() {{
      const active = document.querySelector(".section.active");
      if (!active) return;
      const query = (search.value || "").trim().toLowerCase();
      const activeFilter = active.dataset.activeFilter || "";
      const items = Array.from(active.querySelectorAll(".searchable"));
      let visible = 0;
      items.forEach((item) => {{
        const text = (item.dataset.text || item.textContent || "").toLowerCase();
        const tags = (item.dataset.filterTags || "").toLowerCase();
        const queryMatch = !query || text.includes(query);
        const filterMatch = !activeFilter || tags.split(/\s+/).includes(activeFilter.toLowerCase());
        const show = queryMatch && filterMatch;
        item.style.display = show ? "" : "none";
        if (show) visible += 1;
      }});
      const empty = active.querySelector(".empty");
      if (empty) empty.style.display = items.length && !visible ? "block" : "none";
    }}

    buttons.forEach((button) => button.addEventListener("click", () => activate(button.dataset.tab)));
    search.addEventListener("input", filter);
    filterButtons.forEach((button) => {{
      button.addEventListener("click", () => {{
        const section = document.querySelector(`.section[data-section="${{button.dataset.filterSection}}"]`);
        if (!section) return;
        section.dataset.activeFilter = button.dataset.filter || "";
        section.querySelectorAll(".filter-chip").forEach((item) => item.classList.toggle("active", item === button));
        filter();
      }});
    }});
    scanButtons.forEach((scanButton) => {{
      if (scanButton.dataset.live !== "true") return;
      scanButton.addEventListener("click", async () => {{
        const mode = scanButton.dataset.mode || "daily";
        scanButtons.forEach((button) => button.disabled = true);
        scanStatus.textContent = mode === "deep" ? "正在运行深度盘点，刷新 MCP 状态..." : "正在刷新日常扫描，刷新 MCP 状态...";
        try {{
          const response = await fetch(`/api/scan?mode=${{encodeURIComponent(mode)}}`, {{ method: "POST" }});
          if (!response.ok) throw new Error(await response.text());
          const result = await response.json();
          scanStatus.textContent = `体检完成（${{result.scan_mode}}）：${{result.candidates}} 个候选，${{result.unregistered}} 个未登记。正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          scanStatus.textContent = `扫描失败：${{error.message || error}}`;
          scanButtons.forEach((button) => button.disabled = false);
        }}
      }});
    }});
    projectButtons.forEach((projectButton) => {{
      if (projectButton.dataset.live !== "true") return;
      projectButton.addEventListener("click", async () => {{
        projectButtons.forEach((button) => button.disabled = true);
        if (projectStatus) projectStatus.textContent = "正在刷新项目索引，不移动、不删除文件...";
        try {{
          const response = await fetch("/api/projects/scan", {{ method: "POST" }});
          if (!response.ok) throw new Error(await response.text());
          const result = await response.json();
          if (projectStatus) projectStatus.textContent = `项目索引完成：${{result.projects}} 个项目，${{result.legacy + result.download_candidate}} 个旧位置/下载候选。正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          if (projectStatus) projectStatus.textContent = `项目索引失败：${{error.message || error}}`;
          projectButtons.forEach((button) => button.disabled = false);
        }}
      }});
    }});
    macosButtons.forEach((macosButton) => {{
      if (macosButton.dataset.live !== "true") return;
      macosButton.addEventListener("click", async () => {{
        macosButtons.forEach((button) => button.disabled = true);
        if (macosStatus) macosStatus.textContent = "正在刷新 macOS 系统痕迹，只读不清理...";
        try {{
          const response = await fetch("/api/macos/scan", {{ method: "POST" }});
          if (!response.ok) throw new Error(await response.text());
          const result = await response.json();
          if (macosStatus) macosStatus.textContent = `系统痕迹完成：${{result.items}} 条，${{result.attention}} 条需关注，${{result.residual_candidates}} 条残留候选。正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          if (macosStatus) macosStatus.textContent = `系统痕迹刷新失败：${{error.message || error}}`;
          macosButtons.forEach((button) => button.disabled = false);
        }}
      }});
    }});
    fullUpdateButtons.forEach((fullUpdateButton) => {{
      if (fullUpdateButton.dataset.live !== "true") return;
      fullUpdateButton.addEventListener("click", async () => {{
        fullUpdateButtons.forEach((button) => button.disabled = true);
        if (scanStatus) scanStatus.textContent = "正在更新候选工具、项目索引、系统痕迹和 MCP 状态...";
        try {{
          const response = await fetch("/api/reconcile?mode=daily", {{ method: "POST" }});
          if (!response.ok) throw new Error(await response.text());
          const result = await response.json();
          if (scanStatus) scanStatus.textContent = `更新完成：${{result.candidates}} 个候选，${{result.projects}} 个项目，${{result.macos_signals}} 条系统痕迹。正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          if (scanStatus) scanStatus.textContent = `一键更新失败：${{error.message || error}}`;
          fullUpdateButtons.forEach((button) => button.disabled = false);
        }}
      }});
    }});
    crosscheckButtons.forEach((crosscheckButton) => {{
      if (crosscheckButton.dataset.live !== "true") return;
      crosscheckButton.addEventListener("click", async () => {{
        crosscheckButtons.forEach((button) => button.disabled = true);
        if (scanStatus) scanStatus.textContent = "正在用现有快照交叉校验资产、MCP、项目和系统痕迹...";
        try {{
          const response = await fetch("/api/crosscheck", {{ method: "POST" }});
          if (!response.ok) throw new Error(await response.text());
          const result = await response.json();
          if (scanStatus) scanStatus.textContent = `交叉校验完成：MCP 差异 ${{result.mcp_delta}}，系统待处理 ${{result.macos_open_review}}，未入账 Agent 服务 ${{result.macos_unlinked_agent_services}}。正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          if (scanStatus) scanStatus.textContent = `交叉校验失败：${{error.message || error}}`;
          crosscheckButtons.forEach((button) => button.disabled = false);
        }}
      }});
    }});
    async function postJson(url, payload, button) {{
      if (button) {{
        button.disabled = true;
        button.dataset.originalText = button.textContent;
        button.textContent = "处理中";
      }}
      const response = await fetch(url, {{
        method: "POST",
        headers: {{ "Content-Type": "application/json" }},
        body: JSON.stringify(payload || {{}})
      }});
      if (!response.ok) throw new Error(await response.text());
      return await response.json();
    }}
    function resetActionButton(button) {{
      if (!button) return;
      button.disabled = false;
      if (button.dataset.originalText) button.textContent = button.dataset.originalText;
    }}
    document.querySelectorAll(".js-review").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/review", {{ path: button.dataset.path, status: button.dataset.status }}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `更新处理状态失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-register-candidate").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/register-candidate", {{ path: button.dataset.path }}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `登记候选项失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-register-mcp").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/register-mcp", {{ location: button.dataset.location }}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `纳入 MCP 总账失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-register-all-mcp").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/register-mcp-bulk", {{}}, button);
          window.location.reload();
        }} catch (error) {{
          scanStatus.textContent = `批量纳入 MCP 失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-macos-review").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/macos/review", {{ id: button.dataset.id, status: button.dataset.status }}, button);
          window.location.reload();
        }} catch (error) {{
          if (macosStatus) macosStatus.textContent = `更新系统痕迹状态失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-macos-register").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          await postJson("/api/macos/register", {{ id: button.dataset.id }}, button);
          window.location.reload();
        }} catch (error) {{
          if (macosStatus) macosStatus.textContent = `登记系统痕迹失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    document.querySelectorAll(".js-macos-register-agent-services").forEach((button) => {{
      button.addEventListener("click", async () => {{
        try {{
          const result = await postJson("/api/macos/register-agent-services", {{}}, button);
          if (macosStatus) macosStatus.textContent = `已登记 ${{result.count}} 个未入账 Agent 服务，正在刷新页面...`;
          setTimeout(() => window.location.reload(), 450);
        }} catch (error) {{
          if (macosStatus) macosStatus.textContent = `批量登记 Agent 服务失败：${{error.message || error}}`;
          resetActionButton(button);
        }}
      }});
    }});
    window.addEventListener("hashchange", activateFromHash);
    activateFromHash();
  </script>
</body>
</html>
"""


def build_dashboard(run_discovery=True, refresh_mcp=True, run_projects=True, run_macos=True, live=False, discovery_mode="daily"):
    agent_registry = load_json(REGISTRY)
    mcp_registry = load_json(MCP_REGISTRY)
    discovery_raw = refresh_discovery(mode=discovery_mode) if run_discovery else ""
    project_raw = refresh_projects() if run_projects else ""
    macos_raw = refresh_macos_signals() if run_macos else ""
    discovered_rows, discovered_at, discovered_meta = collect_discovered()
    project_rows, project_at, project_meta = collect_projects()
    macos_rows, macos_at, macos_meta = collect_macos_signals()
    if refresh_mcp:
        health, health_raw = parse_claude_mcp_health()
    else:
        health, health_raw = cached_mcp_health("MCP health cache. Click one-key scan to refresh.")
    mcp_rows = collect_mcp(mcp_registry, health)
    mcp_audit = build_mcp_audit(agent_registry, mcp_registry, mcp_rows)
    entrypoints = collect_entrypoints(agent_registry)
    skill_rows, skill_totals = collect_skills(agent_registry)
    html_text = build_html(
        agent_registry,
        mcp_registry,
        mcp_rows,
        entrypoints,
        skill_rows,
        skill_totals,
        health_raw,
        discovered_rows,
        discovered_at,
        discovery_raw,
        mcp_audit,
        project_rows,
        project_at,
        project_meta,
        macos_rows,
        macos_at,
        macos_meta,
        project_raw,
        macos_raw,
        discovered_meta,
        live=live,
    )
    project_summary = project_meta.get("summary", {})
    macos_summary = macos_meta.get("summary", {})
    assets = agent_registry.get("assets", {})
    agent_app_count = 0
    agent_host_count = 0
    agent_subject_count = 0
    for asset in assets.values():
        categories = set(listify(asset.get("category")))
        is_agent_app = "agent-app" in categories
        is_agent_host = "agent-host" in categories
        if is_agent_app:
            agent_app_count += 1
        if is_agent_host:
            agent_host_count += 1
        if is_agent_app or is_agent_host:
            agent_subject_count += 1
    needs_review = sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status", "new") == "new")
    macos_unlinked_agent_count = len(macos_unlinked_agent_services(macos_rows))
    summary = {
        "assets": len(assets),
        "agent_subjects": agent_subject_count,
        "agent_apps": agent_app_count,
        "agent_hosts": agent_host_count,
        "decision_count": needs_review + macos_unlinked_agent_count,
        "projects": project_summary.get("total", len(project_rows)),
        "project_canonical": project_summary.get("canonical", 0),
        "project_legacy": project_summary.get("legacy", 0),
        "project_download_candidate": project_summary.get("download_candidate", 0),
        "project_host_managed": project_summary.get("host_managed", 0),
        "project_linked": project_summary.get("linked", 0),
        "project_unlinked": sum(1 for row in project_rows if not row.get("linked_assets")),
        "projects_updated_at": project_at,
        "macos_signals": macos_summary.get("total", len(macos_rows)),
        "macos_running": macos_summary.get("running", 0),
        "macos_listening": macos_summary.get("listening", 0),
        "macos_privileged": macos_summary.get("privileged", 0),
        "macos_attention": macos_summary.get("attention", 0),
        "macos_open_review": len(macos_open_review_rows(macos_rows)),
        "macos_unlinked_agent_services": macos_unlinked_agent_count,
        "macos_residual_candidates": macos_summary.get("residual_candidates", 0),
        "macos_updated_at": macos_at,
        "mcp_total": len(mcp_rows),
        "mcp_connected": sum(1 for row in mcp_rows if row["state"] == "connected"),
        "entrypoints": len(entrypoints),
        "valid_entrypoints": sum(1 for row in entrypoints if row["state"] in {"exec", "file", "dir"}),
        "candidates": len(discovered_rows),
        "unregistered": sum(1 for row in discovered_rows if not row.get("registered")),
        "needs_review": needs_review,
        "deferred": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "defer"),
        "ignored": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "ignore"),
        "skills_unique": skill_totals.get("unique", 0),
        "skills_paths": skill_totals.get("paths", 0),
        "skills_recursive_paths": skill_totals.get("recursive_paths", 0),
        "skills_recursive_unique": skill_totals.get("recursive_unique", 0),
        "skills_aliases": skill_totals.get("aliases", 0),
        "skills_nested": skill_totals.get("nested", 0),
        "discovered_at": discovered_at,
        "scan_mode": discovered_meta.get("scan_mode", "daily"),
        "mcp_host_only": mcp_audit["summary"]["host_only"],
        "mcp_registry_only": mcp_audit["summary"]["registry_only"],
    }
    return html_text, summary


def write_dashboard(run_discovery=True, refresh_mcp=True, run_projects=True, run_macos=True, live=False):
    html_text, summary = build_dashboard(run_discovery=run_discovery, refresh_mcp=refresh_mcp, run_projects=run_projects, run_macos=run_macos, live=live)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(html_text, encoding="utf-8")
    return summary


def run_crosscheck():
    summary = write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
    return {
        "ok": True,
        "updated_at": dt.datetime.now().isoformat(timespec="seconds"),
        "assets": summary.get("assets", 0),
        "projects": summary.get("projects", 0),
        "project_unlinked": summary.get("project_unlinked", 0),
        "macos_signals": summary.get("macos_signals", 0),
        "macos_open_review": summary.get("macos_open_review", 0),
        "macos_unlinked_agent_services": summary.get("macos_unlinked_agent_services", 0),
        "mcp_delta": summary.get("mcp_host_only", 0) + summary.get("mcp_registry_only", 0),
        "mcp_host_only": summary.get("mcp_host_only", 0),
        "mcp_registry_only": summary.get("mcp_registry_only", 0),
        "needs_review": summary.get("needs_review", 0),
    }


def run_scan(include_versions=False, mode="daily"):
    discovery_raw = refresh_discovery(include_versions=include_versions, mode=mode)
    discovered_rows, discovered_at, discovered_meta = collect_discovered()
    mcp_registry = load_json(MCP_REGISTRY)
    health, health_raw = parse_claude_mcp_health()
    mcp_rows = collect_mcp(mcp_registry, health)
    write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
    return {
        "ok": True,
        "updated_at": discovered_at,
        "scan_mode": discovered_meta.get("scan_mode", mode),
        "candidates": len(discovered_rows),
        "unregistered": sum(1 for row in discovered_rows if not row.get("registered")),
        "needs_review": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status", "new") == "new"),
        "deferred": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "defer"),
        "ignored": sum(1 for row in discovered_rows if not row.get("registered") and row.get("review_status") == "ignore"),
        "mcp_total": len(mcp_rows),
        "mcp_connected": sum(1 for row in mcp_rows if row["state"] == "connected"),
        "discovery_output": discovery_raw,
        "mcp_output": health_raw,
    }


def run_project_scan():
    project_raw = refresh_projects()
    project_rows, project_at, project_meta = collect_projects()
    write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
    summary = project_meta.get("summary", {})
    return {
        "ok": True,
        "updated_at": project_at,
        "projects": summary.get("total", len(project_rows)),
        "canonical": summary.get("canonical", 0),
        "legacy": summary.get("legacy", 0),
        "download_candidate": summary.get("download_candidate", 0),
        "host_managed": summary.get("host_managed", 0),
        "linked": summary.get("linked", 0),
        "output": project_raw,
    }


def run_macos_scan():
    macos_raw = refresh_macos_signals()
    macos_rows, macos_at, macos_meta = collect_macos_signals()
    write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
    summary = macos_meta.get("summary", {})
    return {
        "ok": True,
        "updated_at": macos_at,
        "items": summary.get("total", len(macos_rows)),
        "running": summary.get("running", 0),
        "listening": summary.get("listening", 0),
        "privileged": summary.get("privileged", 0),
        "attention": summary.get("attention", 0),
        "residual_candidates": summary.get("residual_candidates", 0),
        "output": macos_raw,
    }


def run_reconcile(mode="daily"):
    if mode not in {"daily", "deep"}:
        mode = "daily"
    discovery_raw = refresh_discovery(mode=mode)
    project_raw = refresh_projects()
    macos_raw = refresh_macos_signals()
    health, health_raw = parse_claude_mcp_health()
    discovered_rows, discovered_at, discovered_meta = collect_discovered()
    project_rows, project_at, project_meta = collect_projects()
    macos_rows, macos_at, macos_meta = collect_macos_signals()
    mcp_registry = load_json(MCP_REGISTRY)
    mcp_rows = collect_mcp(mcp_registry, health)
    write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
    return {
        "ok": True,
        "scan_mode": discovered_meta.get("scan_mode", mode),
        "updated_at": dt.datetime.now().isoformat(timespec="seconds"),
        "candidates": len(discovered_rows),
        "unregistered": sum(1 for row in discovered_rows if not row.get("registered")),
        "projects": project_meta.get("summary", {}).get("total", len(project_rows)),
        "projects_updated_at": project_at,
        "macos_signals": macos_meta.get("summary", {}).get("total", len(macos_rows)),
        "macos_open_review": len(macos_open_review_rows(macos_rows)),
        "macos_updated_at": macos_at,
        "mcp_total": len(mcp_rows),
        "mcp_connected": sum(1 for row in mcp_rows if row["state"] == "connected"),
        "discovered_at": discovered_at,
        "discovery_output": discovery_raw,
        "project_output": project_raw,
        "macos_output": macos_raw,
        "mcp_output": health_raw,
    }


class DashboardHandler(http.server.BaseHTTPRequestHandler):
    server_version = "AgentAssetsDashboard/1.0"

    def send_text(self, text, content_type="text/plain; charset=utf-8", status=200, include_body=True):
        data = text.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if include_body:
            self.wfile.write(data)

    def send_json(self, payload, status=200):
        self.send_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", "application/json; charset=utf-8", status)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in {"/", "/dashboard.html"}:
            html_text, _summary = build_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=True)
            self.send_text(html_text, "text/html; charset=utf-8")
            return
        if parsed.path == "/favicon.ico":
            self.send_text("", "image/x-icon", status=204)
            return
        if parsed.path == "/api/status":
            _html_text, summary = build_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=True)
            self.send_json(summary)
            return
        self.send_json({"ok": False, "error": "not found"}, status=404)

    def do_HEAD(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in {"/", "/dashboard.html"}:
            html_text, _summary = build_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=True)
            self.send_text(html_text, "text/html; charset=utf-8", include_body=False)
            return
        if parsed.path == "/api/status":
            _html_text, summary = build_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=True)
            self.send_text(json.dumps(summary, ensure_ascii=False) + "\n", "application/json; charset=utf-8", include_body=False)
            return
        self.send_text("", status=404, include_body=False)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/api/scan":
            query = urllib.parse.parse_qs(parsed.query)
            include_versions = query.get("versions", ["0"])[0] in {"1", "true", "yes"}
            mode = query.get("mode", ["daily"])[0]
            if mode not in {"daily", "deep"}:
                mode = "daily"
            try:
                self.send_json(run_scan(include_versions=include_versions, mode=mode))
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/reconcile":
            query = urllib.parse.parse_qs(parsed.query)
            mode = query.get("mode", ["daily"])[0]
            try:
                self.send_json(run_reconcile(mode=mode))
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/crosscheck":
            try:
                self.send_json(run_crosscheck())
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/projects/scan":
            try:
                self.send_json(run_project_scan())
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/macos/scan":
            try:
                self.send_json(run_macos_scan())
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        length = int(self.headers.get("Content-Length", "0") or "0")
        raw_body = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(raw_body.decode("utf-8") or "{}")
        except json.JSONDecodeError:
            payload = {}
        if parsed.path == "/api/review":
            path_value = str(payload.get("path") or "")
            status = str(payload.get("status") or "")
            if not path_value or status not in {"new", "defer", "ignore"}:
                self.send_json({"ok": False, "error": "invalid review payload"}, status=400)
                return
            try:
                save_review_decision(path_value, status)
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "path": path_value, "status": status})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/macos/review":
            item_id = str(payload.get("id") or "")
            status = str(payload.get("status") or "")
            note = str(payload.get("note") or "")
            if not item_id or status not in MACOS_REVIEW_STATUS_LABELS:
                self.send_json({"ok": False, "error": "invalid macOS review payload"}, status=400)
                return
            try:
                save_macos_review_decision(item_id, status, note=note)
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "id": item_id, "status": status})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/macos/register":
            item_id = str(payload.get("id") or "")
            if not item_id:
                self.send_json({"ok": False, "error": "missing macOS signal id"}, status=400)
                return
            try:
                asset_id = register_macos_signal(item_id)
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "id": item_id, "asset_id": asset_id})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/macos/register-agent-services":
            try:
                asset_ids = register_unlinked_macos_agent_services()
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "asset_ids": asset_ids, "count": len(asset_ids)})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/register-candidate":
            path_value = str(payload.get("path") or "")
            if not path_value:
                self.send_json({"ok": False, "error": "missing candidate path"}, status=400)
                return
            try:
                register_discovered_candidate(path_value)
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "path": path_value})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/register-mcp":
            location = str(payload.get("location") or "")
            if not location:
                self.send_json({"ok": False, "error": "missing mcp location"}, status=400)
                return
            try:
                register_mcp_from_host(location)
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "location": location})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        if parsed.path == "/api/register-mcp-bulk":
            try:
                locations = register_all_host_only_mcp()
                refresh_current_discovery()
                write_dashboard(run_discovery=False, refresh_mcp=False, run_projects=False, run_macos=False, live=False)
                self.send_json({"ok": True, "locations": locations, "count": len(locations)})
            except Exception as exc:
                self.send_json({"ok": False, "error": str(exc)}, status=500)
            return
        self.send_json({"ok": False, "error": "not found"}, status=404)

    def log_message(self, format, *args):
        sys.stderr.write("asset-dashboard: " + (format % args) + "\n")


def serve_dashboard(port, open_browser=False):
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), DashboardHandler)
    url = f"http://127.0.0.1:{port}/"
    write_dashboard(run_discovery=True, refresh_mcp=False, live=False)
    print(url)
    if open_browser:
        subprocess.run(["/usr/bin/open", url], check=False)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(description="Generate or serve the local Agent Assets dashboard.")
    parser.add_argument("--open", action="store_true", help="Open the generated dashboard in the default browser")
    parser.add_argument("--serve", action="store_true", help="Run a local dashboard server with one-click scan support")
    parser.add_argument("--port", type=int, default=int(os.environ.get("AGENT_ASSETS_PORT", "17654")), help="Local dashboard server port")
    args = parser.parse_args()

    if args.serve:
        serve_dashboard(args.port, open_browser=args.open)
        return

    write_dashboard(run_discovery=True, refresh_mcp=True, live=False)
    print(str(OUT))

    if args.open:
        subprocess.run(["/usr/bin/open", str(OUT)], check=False)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"asset-dashboard failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
