#!/usr/bin/env python3
import argparse
import os
import sys
from pathlib import Path

HOME = Path(os.environ.get("AGENT_ASSETS_USER_HOME", str(Path.home()))).expanduser()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", str(HOME / ".config"))).expanduser()
ASSETS_HOME = Path(os.environ.get("AGENT_ASSETS_HOME", str(CONFIG_HOME / "agent-assets"))).expanduser()
STABLE_BIN_DIR = Path(os.environ.get("AGENT_ASSETS_BIN_DIR", str(HOME / ".local/bin"))).expanduser()
PROJECTS_DIR = Path(os.environ.get("AGENT_ASSETS_PROJECTS_DIR", str(HOME / "projects"))).expanduser()

CONTRACT = os.environ.get("AGENT_ASSETS_CONTRACT", str(ASSETS_HOME / "AGENT_CONTRACT.md"))
START_FILE = Path(os.environ.get("AGENT_ASSETS_START_FILE", str(HOME / "AGENT_START_HERE.md"))).expanduser()

SNIPPET = (
    f"Read {START_FILE} first, then follow "
    f"{CONTRACT} before using or "
    "installing local CLI/MCP/Agent assets. Do not ask the user to classify "
    "tools or fill registry fields manually; inspect the registries and update "
    "them yourself when you add an agent-facing asset. Keep durable projects "
    f"under {PROJECTS_DIR}, stable command wrappers under "
    f"{STABLE_BIN_DIR}, stdio MCP wrappers under "
    f"{STABLE_BIN_DIR}/*-mcp, and never store secrets in registries."
)


def main():
    parser = argparse.ArgumentParser(description="Print the local agent-assets contract.")
    parser.add_argument("--snippet", action="store_true", help="Print the short onboarding snippet only")
    parser.add_argument("--path", action="store_true", help="Print only the contract path")
    args = parser.parse_args()

    if args.path:
        print(CONTRACT)
        return
    if args.snippet:
        print(SNIPPET)
        return
    try:
        with open(CONTRACT, "r", encoding="utf-8") as f:
            sys.stdout.write(f.read())
    except FileNotFoundError:
        print(f"Missing contract: {CONTRACT}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
